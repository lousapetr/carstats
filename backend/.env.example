# Copy to .env for local development. In production these are set as real
# secrets on the host (see repo README), never committed.

CARSTATS_DATABASE_URL=sqlite:///./data/carstats.db
CARSTATS_UPLOADS_DIR=./data/uploads
CARSTATS_FRONTEND_DIST_DIR=../frontend/dist

CARSTATS_SESSION_SECRET=change-me-to-a-random-string

CARSTATS_GOOGLE_CLIENT_ID=
CARSTATS_GOOGLE_CLIENT_SECRET=
CARSTATS_OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

CARSTATS_ALLOWED_EMAIL=you@example.com
