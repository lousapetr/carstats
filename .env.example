# Production secrets for the Oracle Cloud VM deployment.
# Copy to .env on the VM (next to docker-compose.yml), fill in real values,
# and never commit the real .env.

CARSTATS_SESSION_SECRET=change-me-to-a-long-random-string

CARSTATS_GOOGLE_CLIENT_ID=
CARSTATS_GOOGLE_CLIENT_SECRET=
CARSTATS_OAUTH_REDIRECT_URL=https://your-tunnel-hostname/auth/callback

CARSTATS_ALLOWED_EMAIL=you@example.com

# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > (your tunnel) > token
CLOUDFLARE_TUNNEL_TOKEN=
